{
	"name": "Streamlit Docker Dev",
	"build": {
		"dockerfile": "../Dockerfile",
		"context": ".."
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance"
			]
		}
	},
	"forwardPorts": [8501],
	"postCreateCommand": "pip install -r requirements.txt",
	"remoteUser": "root"
}
