{
	"name": "Streamlit Android/Windows Dev",
	"build": {
		"dockerfile": "../Dockerfile",
		"context": ".."
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance"
			]
		}
	},
	"forwardPorts": [8501],
	"postCreateCommand": "pip install -r requirements.txt",
	"postStartCommand": "nohup streamlit run windows.py --server.port=8501 --server.address=0.0.0.0 &",
	"remoteUser": "root"
}
